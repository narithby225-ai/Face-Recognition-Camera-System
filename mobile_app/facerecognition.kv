#:kivy 2.0
#:import MDTopAppBar kivymd.uix.toolbar.MDTopAppBar

ScreenManager:
    WelcomeScreen:
    CameraScreen:
    SettingsScreen:

<WelcomeScreen>:
    name: 'welcome'
    
    MDBoxLayout:
        orientation: 'vertical'
        
        MDTopAppBar:
            title: "Face Recognition System"
            elevation: 10
            right_action_items: [["information", lambda x: app.show_info()]]
        
        FloatLayout:
            
            MDCard:
                size_hint: 0.9, None
                height: "300dp"
                pos_hint: {"center_x": 0.5, "center_y": 0.6}
                elevation: 10
                padding: "20dp"
                
                MDBoxLayout:
                    orientation: 'vertical'
                    spacing: "20dp"
                    padding: "20dp"
                    
                    MDLabel:
                        text: "Welcome to"
                        halign: "center"
                        font_style: "H6"
                    
                    MDLabel:
                        text: "Face Recognition System"
                        halign: "center"
                        font_style: "H4"
                        theme_text_color: "Primary"
                    
                    MDLabel:
                        text: "🎯"
                        halign: "center"
                        font_style: "H2"
                    
                    MDLabel:
                        text: "Instant ID & Name Recognition"
                        halign: "center"
                        font_style: "Subtitle1"
            
            MDBoxLayout:
                orientation: 'vertical'
                size_hint: 0.9, None
                height: "200dp"
                pos_hint: {"center_x": 0.5, "center_y": 0.2}
                spacing: "15dp"
                
                MDRaisedButton:
                    text: "START CAMERA"
                    pos_hint: {"center_x": 0.5}
                    size_hint: 0.8, None
                    height: "50dp"
                    md_bg_color: app.theme_cls.primary_color
                    on_release: app.root.current = 'camera'
                
                MDRaisedButton:
                    text: "SETTINGS"
                    pos_hint: {"center_x": 0.5}
                    size_hint: 0.8, None
                    height: "50dp"
                    on_release: app.root.current = 'settings'
                
                MDLabel:
                    text: "43 Students Registered"
                    halign: "center"
                    font_style: "Caption"

<CameraScreen>:
    name: 'camera'
    
    FloatLayout:
        
        # Camera view
        Camera:
            id: camera
            resolution: (640, 480)
            play: True
            size_hint: 1, 1
        
        # Top bar
        MDTopAppBar:
            title: "Live Recognition"
            pos_hint: {"top": 1}
            left_action_items: [["arrow-left", lambda x: app.root.current = 'welcome']]
            right_action_items: [["reload", lambda x: root.engine.load_known_faces()]]
        
        # Recognition result card (center)
        MDCard:
            id: result_card
            size_hint: 0.9, None
            height: "200dp"
            pos_hint: {"center_x": 0.5, "center_y": 0.5}
            elevation: 15
            padding: "20dp"
            opacity: 0
            
            MDBoxLayout:
                orientation: 'vertical'
                spacing: "10dp"
                padding: "10dp"
                
                MDLabel:
                    id: welcome_label
                    text: "WELCOME!"
                    halign: "center"
                    font_style: "H3"
                    theme_text_color: "Custom"
                    text_color: 1, 1, 1, 1
                
                MDLabel:
                    id: id_label
                    text: "ID: DUC20240147"
                    halign: "center"
                    font_style: "H5"
                    theme_text_color: "Custom"
                    text_color: 1, 1, 0.4, 1
                
                MDLabel:
                    id: name_label
                    text: "Student Name"
                    halign: "center"
                    font_style: "H5"
                    theme_text_color: "Custom"
                    text_color: 1, 1, 1, 1
                
                MDLabel:
                    id: confidence_label
                    text: "Confidence: 95%"
                    halign: "center"
                    font_style: "Subtitle1"
                    theme_text_color: "Custom"
                    text_color: 1, 1, 1, 0.8
        
        # Bottom info panel
        MDCard:
            size_hint: 0.95, None
            height: "80dp"
            pos_hint: {"center_x": 0.5, "y": 0.02}
            elevation: 10
            padding: "10dp"
            md_bg_color: 0, 0, 0, 0.7
            
            MDBoxLayout:
                orientation: 'horizontal'
                spacing: "10dp"
                
                MDLabel:
                    text: "👤"
                    font_style: "H4"
                    size_hint_x: 0.2
                
                MDBoxLayout:
                    orientation: 'vertical'
                    
                    MDLabel:
                        text: "Known Faces: " + str(len(root.engine.known_names))
                        font_style: "Subtitle1"
                        theme_text_color: "Custom"
                        text_color: 1, 1, 1, 1
                    
                    MDLabel:
                        text: "Tap reload icon to refresh"
                        font_style: "Caption"
                        theme_text_color: "Custom"
                        text_color: 1, 1, 1, 0.7

<SettingsScreen>:
    name: 'settings'
    
    MDBoxLayout:
        orientation: 'vertical'
        
        MDTopAppBar:
            title: "Settings"
            left_action_items: [["arrow-left", lambda x: app.root.current = 'welcome']]
        
        ScrollView:
            
            MDBoxLayout:
                orientation: 'vertical'
                spacing: "20dp"
                padding: "20dp"
                size_hint_y: None
                height: self.minimum_height
                
                MDCard:
                    size_hint: 1, None
                    height: "100dp"
                    padding: "20dp"
                    
                    MDBoxLayout:
                        orientation: 'vertical'
                        
                        MDLabel:
                            text: "Recognition Tolerance"
                            font_style: "Subtitle1"
                        
                        MDLabel:
                            text: "Adjust sensitivity (0.4 - 0.7)"
                            font_style: "Caption"
                
                MDCard:
                    size_hint: 1, None
                    height: "100dp"
                    padding: "20dp"
                    
                    MDBoxLayout:
                        orientation: 'vertical'
                        
                        MDLabel:
                            text: "Camera Resolution"
                            font_style: "Subtitle1"
                        
                        MDLabel:
                            text: "640x480 (Default)"
                            font_style: "Caption"
                
                MDCard:
                    size_hint: 1, None
                    height: "100dp"
                    padding: "20dp"
                    
                    MDBoxLayout:
                        orientation: 'vertical'
                        
                        MDLabel:
                            text: "Dataset Location"
                            font_style: "Subtitle1"
                        
                        MDLabel:
                            text: "./dataset"
                            font_style: "Caption"
                
                MDRaisedButton:
                    text: "RELOAD FACES FROM DATASET"
                    pos_hint: {"center_x": 0.5}
                    size_hint: 0.9, None
                    height: "50dp"
                    on_release: app.root.get_screen('camera').engine.load_known_faces()
                
                MDLabel:
                    text: "Version 1.0"
                    halign: "center"
                    font_style: "Caption"
                    size_hint_y: None
                    height: "30dp"
